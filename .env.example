# MySQL — formato: mysql://usuario:senha@host:3306/nome_do_banco
# Local: mysql://user:pass@localhost:3306/db
# Railway (dev local): use o host público do proxy, ex. metro.proxy.rlwy.net:PORTA
DATABASE_URL=mysql://root:senha@metro.proxy.rlwy.net:3306/railway

# Autenticação (obrigatório em produção)
JWT_SECRET=troque-por-uma-chave-segura-aleatoria

# Chave mestre permanente para gerenciar a API pública (criar/listar/revogar API keys)
# Use no header: X-Admin-Key: <valor>  OU  Authorization: Bearer <valor>
# Gere com: openssl rand -hex 32
ADMIN_MASTER_KEY=troque-por-32-bytes-aleatorios-em-hex

# Servidor
NODE_ENV=development
PORT=3000

# Frontend (opcional)
VITE_APP_TITLE=Zeglam - Sistema de Cronograma

# Analytics Umami (opcional — só injeta o script se ambos estiverem definidos)
# VITE_ANALYTICS_ENDPOINT=https://analytics.exemplo.com
# VITE_ANALYTICS_WEBSITE_ID=seu-website-id

# OAuth / Forge / WhatsApp (opcional — só se usar essas integrações)
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# WHATSAPP_ADMIN_NUMBER=
